{
  "_comment": "Permissions de l'adaptateur claude-cli en mode hybride (host-agents+docker-verification), passées par `claude -p --settings`. Ne jamais fusionner dans ~/.claude/settings.json. Les permissions natives restent actives : aucun mode bypass. Les règles d'écriture s'expriment par Edit(...) (elles couvrent tous les outils d'écriture). Le bloc `sandbox` est généré par pmx (confinement natif) : ne pas l'ajouter ici.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(src/**)",
      "Edit(test/**)",
      "Bash(python3 -B -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(rm:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -D:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.codex/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/**)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(.claude/**)",
      "Edit(.git)",
      "Edit(.git/**)",
      "Edit(**/hooks/**)",
      "Edit(.gitlab-ci.yml)",
      "Edit(.gitattributes)",
      "Bash(docker:*)",
      "Bash(podman:*)",
      "Bash(nerdctl:*)",
      "Bash(kubectl:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(glab:*)",
      "Bash(gh:*)",
      "Bash(git stash:*)",
      "Bash(git reset --hard:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
